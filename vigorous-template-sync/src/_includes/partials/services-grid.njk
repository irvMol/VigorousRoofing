<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-24">
{% for service in services %}
<a href="/services/{{ service.slug }}/" class="block group h-full">
<div class="h-full p-10 border-l-4 border-brand-primary bg-gray-50 text-[#3d3e3f] transition-all hover:shadow-xl hover:bg-white">
<div class="w-16 h-16 bg-brand-primary/10 text-brand-primary rounded-lg flex items-center justify-center mx-auto mb-6 group-hover:bg-brand-primary group-hover:text-white transition-colors">
{{ service.icon | safe }}
</div>
<h3 class="text-xl font-bold mb-3">{{ service.title }}</h3>
<p class="text-gray-600 text-sm leading-relaxed">{{ service.description }}</p>
</div>
</a>
{% if loop.index % 3 == 0 and not loop.last %}
</div><div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-24">
{% endif %}
{% endfor %}
</div>
