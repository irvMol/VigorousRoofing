---
layout: base.njk
---

<!-- HERO -->
<section class="relative overflow-hidden bg-[#2f2f2f] text-white min-h-[460px]">
{% if heroImage %}
<div class="absolute inset-0 bg-cover bg-center" style="background-image: url('{{ heroImage }}');"></div>
<div class="absolute inset-0 bg-black/65"></div>
{% endif %}
<div class="relative z-10 w-full max-w-5xl mx-auto px-6 pt-16 pb-20">
<nav aria-label="Breadcrumb" class="mb-8">
<ol class="flex flex-wrap items-center gap-2 text-xs uppercase tracking-widest text-white/40">
<li><a href="/" class="hover:text-brand-red transition-colors">Home</a></li>
<li class="text-white/20">/</li>
<li><a href="/services/" class="hover:text-brand-red transition-colors">Services</a></li>
<li class="text-white/20">/</li>
<li class="text-brand-red">{{ title }}</li>
</ol>
</nav>
<p class="uppercase tracking-wide md:tracking-widest text-xs md:text-sm text-brand-red font-semibold mb-3 leading-relaxed">
Roofing Services — Dallas Fort Worth
</p>
<h1 class="text-4xl sm:text-5xl md:text-6xl font-black leading-tight mb-5">
{{ title }}
</h1>
<p class="text-base sm:text-lg text-gray-200 leading-relaxed mb-10 max-w-2xl">
{{ description }}
</p>
<div class="flex flex-col sm:flex-row gap-4 flex-wrap">
<a href="/contact/" class="inline-flex items-center justify-center bg-brand-red text-white font-bold py-4 px-8 rounded-full transition duration-300 shadow-lg hover:bg-red-700">
Get a Free Estimate
</a>
<a href="tel:2147087370" class="inline-flex items-center justify-center border border-white/35 text-white font-bold py-4 px-8 rounded-full transition duration-300">
(214) 708-7370
</a>
</div>
</div>
</section>

<!-- TRUST STRIP -->
<div class="bg-[#1a1a1a] border-y border-white/10">
<div class="max-w-6xl mx-auto px-6 py-4 flex flex-wrap items-center justify-center gap-y-2 gap-x-6 text-sm font-semibold text-white text-center">
<span>✓ Licensed &amp; Insured</span>
<span class="text-white/20 hidden sm:inline">|</span>
<span>✓ Free Estimates</span>
<span class="text-white/20 hidden sm:inline">|</span>
<span>✓ Quality Workmanship</span>
<span class="text-white/20 hidden sm:inline">|</span>
<span>✓ Serving All of DFW</span>
</div>
</div>

<!-- MAIN CONTENT -->
<section class="bg-[#f5f5f5] py-20">
<div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
<div>
<p class="uppercase tracking-widest text-xs text-brand-red font-bold mb-4">
Trusted Roofing Solutions
</p>
<h2 class="text-4xl font-black text-[#2f2f2f] leading-tight mb-4">
Professional <span class="text-brand-red">{{ title }}</span>
</h2>
<div class="w-16 h-1 bg-brand-red rounded-full mb-8"></div>
<div class="prose prose-base md:prose-lg prose-gray max-w-none text-gray-700 prose-headings:text-[#2f2f2f] prose-headings:font-black prose-p:text-gray-700 prose-p:leading-relaxed prose-li:text-gray-700 prose-li:marker:text-brand-red">
{{ content | safe }}
</div>
</div>
<div>
<div class="rounded-2xl overflow-hidden shadow-2xl bg-gray-200 min-h-[360px] flex items-center justify-center">
{% if serviceImage %}
{% image
serviceImage,
title + " in Dallas-Fort Worth TX by Vigorous Roofing",
"(max-width: 768px) 100vw, 50vw",
"w-full h-full object-cover"
%}
{% else %}
<span class="text-gray-400 text-sm">
Service Image
</span>
{% endif %}
</div>
<div class="mt-6 grid grid-cols-3 gap-px bg-gray-200 rounded-2xl overflow-hidden shadow-md">
<div class="bg-white p-4 text-center">
<p class="text-2xl font-black text-brand-red">10+</p>
<p class="text-xs text-gray-500 mt-1 uppercase tracking-wide">
Years in DFW
</p>
</div>
<div class="bg-white p-4 text-center">
<p class="text-2xl font-black text-brand-red">500+</p>
<p class="text-xs text-gray-500 mt-1 uppercase tracking-wide">
Jobs Done
</p>
</div>
<div class="bg-white p-4 text-center">
<p class="text-2xl font-black text-brand-red">100%</p>
<p class="text-xs text-gray-500 mt-1 uppercase tracking-wide">
Licensed
</p>
</div>
</div>
</div>
</div>
</section>

<!-- WHY US -->
<section class="bg-white py-20 border-t border-gray-100">
<div class="max-w-6xl mx-auto px-6">
<div class="text-center mb-14">
<p class="uppercase tracking-widest text-xs text-brand-red font-bold mb-3">
Our Promise
</p>
<h2 class="text-3xl md:text-4xl font-black text-[#2f2f2f] mb-3">
Why Choose Vigorous Roofing
</h2>
<p class="text-gray-500 max-w-xl mx-auto text-sm md:text-base">
Dependable workmanship across Dallas, Fort Worth, and surrounding areas.
</p>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
<div class="p-8 rounded-2xl border border-gray-100 transition-all duration-300">
<div class="w-11 h-11 rounded-xl bg-brand-red/10 flex items-center justify-center mb-5">
<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
</svg>
</div>
<h3 class="font-black text-xl text-[#2f2f2f] mb-2">
Experienced Team
</h3>
<p class="text-gray-500 text-sm leading-relaxed">
Skilled professionals focused on long-lasting results — every job, every time.
</p>
</div>
<div class="p-8 rounded-2xl border border-gray-100 transition-all duration-300">
<div class="w-11 h-11 rounded-xl bg-brand-red/10 flex items-center justify-center mb-5">
<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
</svg>
</div>
<h3 class="font-black text-xl text-[#2f2f2f] mb-2">
Quality Materials
</h3>
<p class="text-gray-500 text-sm leading-relaxed">
Durable products built to withstand Texas hail, heat, and heavy rain.
</p>
</div>
<div class="p-8 rounded-2xl border border-gray-100 transition-all duration-300">
<div class="w-11 h-11 rounded-xl bg-brand-red/10 flex items-center justify-center mb-5">
<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
</svg>
</div>
<h3 class="font-black text-xl text-[#2f2f2f] mb-2">
Honest Communication
</h3>
<p class="text-gray-500 text-sm leading-relaxed">
Clear estimates and responsive service from first call to final inspection.
</p>
</div>
</div>
</div>
</section>

<!-- CTA -->
<section class="bg-brand-red text-white py-20 relative overflow-hidden">
<div class="absolute inset-0 opacity-10" style="background-image: repeating-linear-gradient(45deg,#fff 0,#fff 1px,transparent 0,transparent 50%); background-size: 12px 12px;"></div>
<div class="relative max-w-4xl mx-auto px-6 text-center">
<p class="uppercase tracking-widest text-xs text-white/60 font-bold mb-4">
Dallas–Fort Worth
</p>
<h2 class="text-4xl md:text-5xl font-black leading-tight mb-5">
Need {{ title }}?
</h2>
<p class="text-base md:text-lg text-white/85 max-w-xl mx-auto leading-relaxed mb-10">
Contact Vigorous Roofing today for a free inspection and no-obligation estimate.
</p>
<div class="flex flex-col sm:flex-row gap-4 justify-center">
<a href="/contact/" class="inline-flex items-center justify-center bg-white text-brand-red font-black py-4 px-8 rounded-full shadow-xl">
Request a Free Estimate
</a>
<a href="tel:2147087370" class="inline-flex items-center justify-center border-2 border-white/50 text-white font-bold py-4 px-8 rounded-full">
(214) 708-7370
</a>
</div>
</div>
</section>