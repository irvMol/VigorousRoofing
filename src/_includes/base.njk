<!DOCTYPE HTML>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
{%- set pageTitle = (seoTitle or title) %}
{%- set fullTitle = (pageTitle + " | " + business.name) if pageTitle else (site.title + " | " + site.tagline) %}
{%- set metaDescription = description or site.description %}
{%- set canonicalUrl = site.siteUrl + page.url %}
{%- set shareImage = site.siteUrl + (ogImage or site.ogImage) %}
    <title>{{ fullTitle }}</title>
    <meta name="description" content="{{ metaDescription }}">
    <link rel="canonical" href="{{ canonicalUrl }}">
{%- if noindex %}
    <meta name="robots" content="noindex, follow">
{%- endif %}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ business.name }}">
    <meta property="og:title" content="{{ fullTitle }}">
    <meta property="og:description" content="{{ metaDescription }}">
    <meta property="og:url" content="{{ canonicalUrl }}">
    <meta property="og:image" content="{{ shareImage }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ fullTitle }}">
    <meta name="twitter:description" content="{{ metaDescription }}">
    <meta name="twitter:image" content="{{ shareImage }}">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/icons/favicon-32.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/images/icons/icon-192.png">
    <link rel="apple-touch-icon" href="/assets/images/icons/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Archivo+Black&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/output.css">
    <style>
      :root {
        --color-brand-primary: {{ theme.primaryColor }};
        --color-brand-dark-grey: {{ theme.darkColor }};
        --color-brand-grey: {{ theme.greyColor }};
      }
    </style>
    <script type="application/ld+json">{{ schema | dump | safe }}</script>
{%- if breadcrumbs %}
    <script type="application/ld+json">{{ breadcrumbs | dump | safe }}</script>
{%- endif %}
</head>
<body class="bg-brand-grey text-white font-sans antialiased overflow-x-hidden">
    <div class="flex flex-col min-h-screen">
<header class="sticky top-0 z-50 bg-brand-dark-grey/90 backdrop-blur-sm border-b border-white/10">
<div class="max-w-6xl mx-auto px-4 h-20 flex justify-between items-center">
<!-- Desktop Nav -->
<nav class="hidden md:block">
<ul class="flex items-center space-x-8 text-sm font-medium tracking-wide">
<li><a href="/" class="hover:text-brand-primary transition-colors">HOME</a></li>
<li><a href="/services/" class="hover:text-brand-primary transition-colors">SERVICES</a></li>
<li><a href="/gallery/" class="hover:text-brand-primary transition-colors">GALLERY</a></li>
<li>
<a href="/contact/" class="bg-brand-primary px-5 py-2 rounded shadow-lg hover:bg-red-700 transition-all">
CONTACT
</a>
</li>
</ul>
</nav>
<!-- Mobile Hamburger -->
<button id="mobile-menu-button" class="md:hidden flex items-center justify-center w-11 h-11 rounded-lg border border-white/10 text-white hover:bg-white/5 transition" aria-label="Open menu">
<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
</svg>
</button>
</div>
<!-- Mobile Menu -->
<div id="mobile-menu" class="hidden md:hidden border-t border-white/10 bg-brand-dark-grey/95 backdrop-blur-md">
<nav class="max-w-6xl mx-auto px-4 py-4">
<ul class="flex flex-col space-y-2 text-sm font-medium tracking-wide">
<li><a href="/" class="block px-4 py-3 rounded-lg hover:bg-white/5 transition-colors">HOME</a></li>
<li><a href="/services/" class="block px-4 py-3 rounded-lg hover:bg-white/5 transition-colors">SERVICES</a></li>
<li><a href="/gallery/" class="block px-4 py-3 rounded-lg hover:bg-white/5 transition-colors">GALLERY</a></li>
<li class="pt-2">
<a href="/contact/" class="block text-center bg-brand-primary px-5 py-3 rounded-lg shadow-lg hover:bg-red-700 transition-all">CONTACT</a>
</li>
</ul>
</nav>
</div>
<script>
document.addEventListener("DOMContentLoaded", () => {
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  button.addEventListener("click", () => {
    menu.classList.toggle("hidden");
  });
});
</script>
</header>
<main class="flex-grow w-full">
        {{ content | safe }}
</main>
        <footer class="bg-brand-dark-grey/90 border-t border-white/5 py-12">
            <div class="max-w-6xl mx-auto px-4">
                <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                    <div class="text-center md:text-left">
                        <p class="text-gray-400 text-sm">
                            &copy; {% year %} {{ business.name }}.
                        </p>
                        <p class="text-xs text-gray-500 mt-1">Serving {{ business.serviceArea }}</p>
                    </div>
                   <div class="flex items-center gap-6">
                        <a href="tel:{{ business.phone }}" class="flex items-center gap-2 text-gray-300 hover:text-brand-primary transition-colors">
                        {% icon "solid", "phone" %}
                        <span class="text-xs uppercase font-bold tracking-widest">Call</span>
                        </a>
                        <a href="mailto:{{ business.email }}" class="flex items-center gap-2 text-gray-300 hover:text-brand-primary transition-colors">
                        {% icon "solid", "envelope" %}
                        <span class="text-xs uppercase font-bold tracking-widest">Email</span>
                        </a>
                        {% if business.facebook %}
                        <a href="{{ business.facebook }}" target="_blank" rel="noopener" aria-label="Facebook" class="text-gray-300 hover:text-brand-primary transition-colors">
                        {% icon "brands", "facebook", "w-5 h-5" %}
                        </a>
                        {% endif %}
                        {% if business.whatsapp %}
                        <a href="https://wa.me/{{ business.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp" class="text-gray-300 hover:text-brand-primary transition-colors">
                        {% icon "brands", "whatsapp", "w-5 h-5" %}
                        </a>
                        {% endif %}
                        {% if business.instagram %}
                        <a href="{{ business.instagram }}" target="_blank" rel="noopener" aria-label="Instagram" class="text-gray-300 hover:text-brand-primary transition-colors">
                        {% icon "brands", "instagram", "w-5 h-5" %}
                        </a>
                        {% endif %}
                        </div>
                </div>
            </div>
        </footer>
    </div>
<!-- Lightbox Modal -->
<div id="lightbox" class="hidden fixed inset-0 z-[100] items-center justify-center bg-black/90 opacity-0 transition-opacity duration-300 p-4">
  <button id="lightbox-close" class="absolute top-6 right-6 text-white text-4xl leading-none hover:text-brand-primary transition-colors" aria-label="Close">
    &times;
  </button>
  <figure class="max-w-4xl max-h-full flex flex-col items-center">
    <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[80vh] object-contain rounded-2xl shadow-2xl">
    <figcaption id="lightbox-caption" class="text-gray-300 text-sm mt-4 text-center"></figcaption>
  </figure>
</div>
<script src="/assets/js/lightbox.js" defer></script>
</body>
</html>
