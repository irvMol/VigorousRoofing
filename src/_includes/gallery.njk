---
layout: base.njk
templateEngineOverride: njk
---

<section class="relative overflow-hidden bg-[#2f2f2f] text-white">
    <div class="max-w-5xl mx-auto px-6 py-24 md:py-32 text-center">
        <p class="uppercase tracking-[0.15em] text-xs text-brand-red font-semibold mb-4">
            Dallas–Fort Worth Roofing Projects
        </p>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black leading-tight mb-6">
            {{ title }}
        </h1>
        <p class="max-w-2xl mx-auto text-base md:text-lg text-gray-300 leading-relaxed">
            {{ description }}
        </p>
    </div>
</section>

<section class="bg-white py-16 border-t border-gray-100">
    <div class="max-w-3xl mx-auto px-6 text-center">
        <p class="text-gray-600 leading-relaxed text-base md:text-lg">
            A selection of recent roofing and construction projects completed across Dallas–Fort Worth.
        </p>
    </div>
</section>

<section class="bg-[#f7f7f7] py-20">
    <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

            <button class="group text-left lightbox-trigger focus:outline-none" data-full="/assets/images/residential-1.jpg" data-alt="Residential roofing project in Dallas Texas">
                <div class="overflow-hidden rounded-2xl bg-gray-200 cursor-pointer">
                    {% image
                    "/assets/images/residential-1.jpg",
                    "Residential roofing project in Dallas Texas",
                    "(max-width: 768px) 100vw, 33vw",
                    "w-full aspect-square object-cover transition duration-500 group-hover:scale-105"
                    %}
                </div>
                <div class="pt-4">
                    <p class="text-xs uppercase tracking-[0.12em] text-brand-red font-semibold mb-1">
                        Residential Roofing
                    </p>
                    <p class="text-sm text-gray-500">
                        Dallas, Texas
                    </p>
                </div>
            </button>

            <button class="group text-left lightbox-trigger focus:outline-none" data-full="/assets/images/residential-2.jpg" data-alt="Storm damage roofing repair in Fort Worth Texas">
                <div class="overflow-hidden rounded-2xl bg-gray-200 cursor-pointer">
                    {% image
                    "/assets/images/residential-2.jpg",
                    "Storm damage roofing repair in Fort Worth Texas",
                    "(max-width: 768px) 100vw, 33vw",
                    "w-full aspect-square object-cover transition duration-500 group-hover:scale-105"
                    %}
                </div>
                <div class="pt-4">
                    <p class="text-xs uppercase tracking-[0.12em] text-brand-red font-semibold mb-1">
                        Storm Damage
                    </p>
                    <p class="text-sm text-gray-500">
                        Fort Worth, Texas
                    </p>
                </div>
            </button>

            <button class="group text-left lightbox-trigger focus:outline-none" data-full="/assets/images/residential-3.jpg" data-alt="Shingle roofing installation project">
                <div class="overflow-hidden rounded-2xl bg-gray-200 cursor-pointer">
                    {% image
                    "/assets/images/residential-3.jpg",
                    "Shingle roofing installation project",
                    "(max-width: 768px) 100vw, 33vw",
                    "w-full aspect-square object-cover transition duration-500 group-hover:scale-105"
                    %}
                </div>
                <div class="pt-4">
                    <p class="text-xs uppercase tracking-[0.12em] text-brand-red font-semibold mb-1">
                        Roof Installation
                    </p>
                    <p class="text-sm text-gray-500">
                        Arlington, Texas
                    </p>
                </div>
            </button>

            <button class="group text-left lightbox-trigger focus:outline-none" data-full="/assets/images/commercial-1.jpg" data-alt="Commercial flat roofing project">
                <div class="overflow-hidden rounded-2xl bg-gray-200 cursor-pointer">
                    {% image
                    "/assets/images/commercial-1.jpg",
                    "Commercial flat roofing project",
                    "(max-width: 768px) 100vw, 33vw",
                    "w-full aspect-square object-cover transition duration-500 group-hover:scale-105"
                    %}
                </div>
                <div class="pt-4">
                    <p class="text-xs uppercase tracking-[0.12em] text-brand-red font-semibold mb-1">
                        Commercial Roofing
                    </p>
                    <p class="text-sm text-gray-500">
                        Dallas–Fort Worth
                    </p>
                </div>
            </button>

            <button class="group text-left lightbox-trigger focus:outline-none" data-full="/assets/images/commercial-2.jpg" data-alt="Commercial roofing repair">
                <div class="overflow-hidden rounded-2xl bg-gray-200 cursor-pointer">
                    {% image
                    "/assets/images/commercial-2.jpg",
                    "Commercial roofing repair",
                    "(max-width: 768px) 100vw, 33vw",
                    "w-full aspect-square object-cover transition duration-500 group-hover:scale-105"
                    %}
                </div>
                <div class="pt-4">
                    <p class="text-xs uppercase tracking-[0.12em] text-brand-red font-semibold mb-1">
                        Roof Repair
                    </p>
                    <p class="text-sm text-gray-500">
                        Plano, Texas
                    </p>
                </div>
            </button>

            <button class="group text-left lightbox-trigger focus:outline-none" data-full="/assets/images/commercial-3.jpg" data-alt="Commercial roof coating project">
                <div class="overflow-hidden rounded-2xl bg-gray-200 cursor-pointer">
                    {% image
                    "/assets/images/commercial-3.jpg",
                    "Commercial roof coating project",
                    "(max-width: 768px) 100vw, 33vw",
                    "w-full aspect-square object-cover transition duration-500 group-hover:scale-105"
                    %}
                </div>
                <div class="pt-4">
                    <p class="text-xs uppercase tracking-[0.12em] text-brand-red font-semibold mb-1">
                        Roof Coating
                    </p>
                    <p class="text-sm text-gray-500">
                        Irving, Texas
                    </p>
                </div>
            </button>

        </div>
    </div>
</section>

<div id="lightbox" class="fixed inset-0 z-50 hidden flex-col items-center justify-center bg-black/90 p-4 transition-opacity duration-300 opacity-0">
    <button id="lightbox-close" class="absolute top-6 right-6 text-white/70 hover:text-white p-2 focus:outline-none" aria-label="Close Lightbox">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
    </button>
    
    <div class="max-w-5xl max-h-[85vh] flex items-center justify-center">
        <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[80vh] object-contain rounded shadow-2xl select-none">
    </div>
    
    <p id="lightbox-caption" class="mt-4 text-sm tracking-wide text-gray-300 font-medium px-4 text-center"></p>
</div>

<section class="bg-brand-red text-white py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
        <h2 class="text-4xl md:text-5xl font-black leading-tight mb-6">
            Need Roofing Services?
        </h2>
        <p class="max-w-2xl mx-auto text-base md:text-lg text-white/85 leading-relaxed mb-10">
            Contact Vigorous Roofing today for a free inspection and estimate.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/contact/"
                class="inline-flex items-center justify-center bg-white text-brand-red font-black py-4 px-8 rounded-full hover:bg-gray-100 transition">
                Request a Free Estimate
            </a>
            <a href="tel:2147087370"
                class="inline-flex items-center justify-center border-2 border-white/40 text-white font-bold py-4 px-8 rounded-full hover:bg-white/10 transition">
                (214) 708-7370
            </a>
        </div>
    </div>
</section>