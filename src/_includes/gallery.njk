---
layout: base.njk
templateEngineOverride: njk
---

<!-- HERO -->
<section class="relative overflow-hidden bg-[#2f2f2f] text-white">
    <div class="max-w-5xl mx-auto px-6 py-24 md:py-32 text-center">

        <p class="uppercase tracking-[0.15em] text-xs text-brand-red font-semibold mb-4">
            Dallas–Fort Worth Roofing Projects
        </p>

        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black leading-tight mb-6">
            {{ title }}
        </h1>

        <p class="max-w-2xl mx-auto text-base md:text-lg text-gray-300 leading-relaxed">
            {{ description }}
        </p>

    </div>

</section>

<!-- INTRO -->
<section class="bg-white py-16 border-t border-gray-100">
    <div class="max-w-3xl mx-auto px-6 text-center">

        <p class="text-gray-600 leading-relaxed text-base md:text-lg">
            A selection of recent roofing and construction projects completed across Dallas–Fort Worth.
        </p>

    </div>

</section>

<!-- GALLERY GRID -->
<section class="bg-[#f7f7f7] py-20">
    <div class="max-w-6xl mx-auto px-6">

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

            <!-- IMAGE -->
            <div class="group">
                <div class="overflow-hidden rounded-2xl bg-gray-200">
                    {% image
                    "/assets/images/residential-1.jpg",
                    "Residential roofing project in Dallas Texas",
                    "(max-width: 768px) 100vw, 33vw",
                    "w-full aspect-[4/3] object-cover transition duration-500 group-hover:scale-105"
                    %}
                </div>

                <div class="pt-4">
                    <p class="text-xs uppercase tracking-[0.12em] text-brand-red font-semibold mb-1">
                        Residential Roofing
                    </p>

                    <p class="text-sm text-gray-500">
                        Dallas, Texas
                    </p>
                </div>
            </div>

            <!-- IMAGE -->
            <div class="group">
                <div class="overflow-hidden rounded-2xl bg-gray-200">
                    {% image
                    "/assets/images/residential-2.jpg",
                    "Storm damage roofing repair in Fort Worth Texas",
                    "(max-width: 768px) 100vw, 33vw",
                    "w-full aspect-[4/3] object-cover transition duration-500 group-hover:scale-105"
                    %}
                </div>

                <div class="pt-4">
                    <p class="text-xs uppercase tracking-[0.12em] text-brand-red font-semibold mb-1">
                        Storm Damage
                    </p>

                    <p class="text-sm text-gray-500">
                        Fort Worth, Texas
                    </p>
                </div>
            </div>

            <!-- IMAGE -->
            <div class="group">
                <div class="overflow-hidden rounded-2xl bg-gray-200">
                    {% image
                    "/assets/images/residential-3.jpg",
                    "Shingle roofing installation project",
                    "(max-width: 768px) 100vw, 33vw",
                    "w-full aspect-[4/3] object-cover transition duration-500 group-hover:scale-105"
                    %}
                </div>

                <div class="pt-4">
                    <p class="text-xs uppercase tracking-[0.12em] text-brand-red font-semibold mb-1">
                        Roof Installation
                    </p>

                    <p class="text-sm text-gray-500">
                        Arlington, Texas
                    </p>
                </div>
            </div>

            <!-- IMAGE -->
            <div class="group">
                <div class="overflow-hidden rounded-2xl bg-gray-200">
                    {% image
                    "/assets/images/commercial-1.jpg",
                    "Commercial flat roofing project",
                    "(max-width: 768px) 100vw, 33vw",
                    "w-full aspect-[4/3] object-cover transition duration-500 group-hover:scale-105"
                    %}
                </div>

                <div class="pt-4">
                    <p class="text-xs uppercase tracking-[0.12em] text-brand-red font-semibold mb-1">
                        Commercial Roofing
                    </p>

                    <p class="text-sm text-gray-500">
                        Dallas–Fort Worth
                    </p>
                </div>
            </div>

            <!-- IMAGE -->
            <div class="group">
                <div class="overflow-hidden rounded-2xl bg-gray-200">
                    {% image
                    "/assets/images/commercial-2.jpg",
                    "Commercial roofing repair",
                    "(max-width: 768px) 100vw, 33vw",
                    "w-full aspect-[4/3] object-cover transition duration-500 group-hover:scale-105"
                    %}
                </div>

                <div class="pt-4">
                    <p class="text-xs uppercase tracking-[0.12em] text-brand-red font-semibold mb-1">
                        Roof Repair
                    </p>

                    <p class="text-sm text-gray-500">
                        Plano, Texas
                    </p>
                </div>
            </div>

            <!-- IMAGE -->
            <div class="group">
                <div class="overflow-hidden rounded-2xl bg-gray-200">
                    {% image
                    "/assets/images/commercial-3.jpg",
                    "Commercial roof coating project",
                    "(max-width: 768px) 100vw, 33vw",
                    "w-full aspect-[4/3] object-cover transition duration-500 group-hover:scale-105"
                    %}
                </div>

                <div class="pt-4">
                    <p class="text-xs uppercase tracking-[0.12em] text-brand-red font-semibold mb-1">
                        Roof Coating
                    </p>

                    <p class="text-sm text-gray-500">
                        Irving, Texas
                    </p>
                </div>
            </div>

        </div>

    </div>

</section>

<!-- CTA -->
<section class="bg-brand-red text-white py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">

        <h2 class="text-4xl md:text-5xl font-black leading-tight mb-6">
            Need Roofing Services?
        </h2>

        <p class="max-w-2xl mx-auto text-base md:text-lg text-white/85 leading-relaxed mb-10">
            Contact Vigorous Roofing today for a free inspection and estimate.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">

            <a href="/contact/"
                class="inline-flex items-center justify-center bg-white text-brand-red font-black py-4 px-8 rounded-full hover:bg-gray-100 transition">
                Request a Free Estimate
            </a>

            <a href="tel:2147087370"
                class="inline-flex items-center justify-center border-2 border-white/40 text-white font-bold py-4 px-8 rounded-full hover:bg-white/10 transition">
                (214) 708-7370
            </a>

        </div>

    </div>

</section>
