<form
  action="https://api.web3forms.com/submit"
  method="POST"
  class="{% if compact %}space-y-4{% else %}bg-white rounded-3xl shadow-2xl p-8 md:p-10 space-y-6{% endif %}"
>
<input
type="hidden"
name="access_key"
value="30289b05-2470-40da-b943-2a8f764bc8ac"
>
 <input
    type="hidden"
    name="redirect"
    value="/thank-you/"
>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<div>
  <label for="name" class="block text-sm font-bold text-gray-700 mb-2">
    Name
  </label>
  <input
    type="text"
    id="name"
    name="name"
    required
    class="w-full p-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-red focus:outline-none text-gray-900 bg-white"
  >
</div>
<div>
  <label for="phone" class="block text-sm font-bold text-gray-700 mb-2">
    Phone Number
  </label>
  <input
    type="tel"
    id="phone"
    name="phone"
    required
    class="w-full p-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-red focus:outline-none text-gray-900 bg-white"
  >
</div>
</div>
{% if not compact %}
<div>
    <label for="email" class="block text-sm font-bold text-gray-700 mb-2">
      Email
    </label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="w-full p-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-red focus:outline-none text-gray-900 bg-white"
    >
  </div>
<div>
    <label for="service" class="block text-sm font-bold text-gray-700 mb-2">
      Service Needed
    </label>
    <select
      id="service"
      name="service"
      class="w-full p-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-red focus:outline-none text-gray-900 bg-white"
    >
      <option>Roof Repair</option>
      <option>Roof Replacement</option>
      <option>Storm Damage Inspection</option>
      <option>Commercial Roofing</option>
      <option>Construction Services</option>
      <option>Other</option>
    </select>
  </div>
{% endif %}
<div>
    <label for="message" class="block text-sm font-bold text-gray-700 mb-2">
      {% if compact %}
        How Can We Help?
      {% else %}
        Project Details
      {% endif %}
    </label>
<textarea
  id="message"
  name="message"
  rows="{% if compact %}4{% else %}6{% endif %}"
  required
  placeholder="Tell us about your project..."
  class="w-full p-3 border border-gray-300 rounded-xl resize-none focus:ring-2 focus:ring-brand-red focus:outline-none text-gray-900 bg-white"
></textarea>
  </div>
<button
type="submit"
class="w-full bg-brand-red text-white font-black py-4 rounded-xl hover:opacity-90 transition"
>
Request Free Estimate
</button>

</form>
