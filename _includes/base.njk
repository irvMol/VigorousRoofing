<!DOCTYPE HTML>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title or "Vigorous Roofing and Construction" }}</title>
    
    <link rel="stylesheet" href="/assets/css/output.css">
    
    <!-- Meta description for Local SEO -->
    <meta name="description" content="Professional roofing and construction services in Dallas Fort Worth and surrounding areas.">
</head>
<body class="bg-gray-50 text-gray-900 antialiased">

    <div id="wrapper" class="flex flex-col min-h-screen">

        <header id="header" class="p-6">
            <div class="inner flex justify-between items-center max-w-6xl mx-auto">
                <a href="/" class="logo">
                    <img src="/assets/images/logo/vigorous-logo-clear.png" alt="Vigorous Roofing Logo" class="h-12 w-auto" />
                </a>

                <nav>
                    <ul class="flex space-x-6">
                        <li><a href="/" class="hover:text-blue-600">Home</a></li>
                        <li><a href="/#services" class="hover:text-blue-600">Services</a></li>
                        <li><a href="/gallery/" class="hover:text-blue-600">Gallery</a></li>
                        <li><a href="/#contact" class="hover:text-blue-600">Contact</a></li>
                    </ul>
                </nav>
            </div>
        </header>

        <main id="main" class="flex-grow">
            <div class="inner max-w-6xl mx-auto p-6">
                {{ content | safe }}
            </div>
        </main>

        <footer id="footer" class="p-10 bg-white border-t border-gray-200">
            <div class="inner max-w-6xl mx-auto">
                <!-- Basic Contact Section -->
                <div class="flex flex-col md:flex-row justify-between items-center">
                    <p class="text-sm text-gray-500">
                        &copy; {{ page.date.getFullYear() if page.date else "2026" }} Vigorous Roofing. All rights reserved.
                    </p>
                    <div class="flex space-x-4 mt-4 md:mt-0">
                        <a href="tel:303-XXX-XXXX" class="text-gray-600 hover:text-blue-600">Phone</a>
                        <a href="mailto:support@vigorousroofing.com" class="text-gray-600 hover:text-blue-600">Email</a>
                    </div>
                </div>
            </div>
        </footer>

    </div>

</body>
</html>